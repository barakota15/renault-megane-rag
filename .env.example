# Renault Megane Workshop Manual RAG Configuration

# Choose your preferred LLM provider: "gemini", "groq", "openai", or "ollama"
DEFAULT_PROVIDER=gemini

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# Groq API Key (Ultra-fast Llama 3.3 70B inference)
GROQ_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Ollama Local Configuration (Optional, for 100% offline local model)
OLLAMA_BASE_URL=http://localhost:11434/api/generate
